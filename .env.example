# CampusMind AI — local environment template
# Copy to `.env` and adjust. Never commit real secrets.
# Docker Compose reads this file for variable substitution.

# -----------------------------------------------------------------------------
# PostgreSQL (Docker Compose) — Phase 1A
# Development placeholders only. Change POSTGRES_PASSWORD for anything shared.
# Keep DATABASE_URL credentials in sync with POSTGRES_* values below.
# -----------------------------------------------------------------------------
POSTGRES_DB=campusmind
POSTGRES_USER=campusmind
POSTGRES_PASSWORD=campusmind
POSTGRES_PORT=5432

# Used by Prisma / NestJS in later phases (must match POSTGRES_* above)
DATABASE_URL=postgresql://campusmind:campusmind@localhost:5432/campusmind?schema=public

# NestJS core API — Phase 1B+
API_PORT=3000

# FastAPI AI service — later Phase 1
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# OpenAI-compatible LLM provider — Phase 2+ (leave empty for now)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Authentication — local development placeholders only
JWT_SECRET=change-me
JWT_EXPIRES_IN=1h

# Expo mobile client — later Phase 1
# Android emulator may need http://10.0.2.2:3000 instead of localhost
EXPO_PUBLIC_API_URL=http://localhost:3000
