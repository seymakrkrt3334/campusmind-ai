# CampusMind AI — local environment template
# Copy to `.env` and adjust. Never commit real secrets.

# PostgreSQL (Prisma / NestJS) — Phase 1+
DATABASE_URL=postgresql://campusmind:campusmind@localhost:5432/campusmind?schema=public

# NestJS core API — Phase 1+
API_PORT=3000

# FastAPI AI service — Phase 1+
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# OpenAI-compatible LLM provider — Phase 2+ (leave empty for now)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Future authentication — not used in Phase 1 endpoints
JWT_SECRET=

# Expo mobile client — Phase 1+
# Android emulator may need http://10.0.2.2:3000 instead of localhost
EXPO_PUBLIC_API_URL=http://localhost:3000
